#!/bin/sh

# The release's node name and distribution mode. Phoenix's generated
# release environment, unchanged apart from this comment.

# Sets and unsets node distribution flags, per mode:
#  - "embedded" (bin/... start): long-lived, name-based distribution so
#    clustering (dns_cluster) and remote eval work.
#  - "interactive" (bin/... remote): same, for a shell into the node.
case "$RELEASE_MODE" in
  "interactive" | "embedded")
    RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
    ;;

  # eval and other one-off commands still name themselves, so a second
  # machine in the cluster can address them if it ever needs to.
  *)
    RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
    ;;
esac

# Pick this node's IPv4 (or IPv6, via RELEASE_IP=6) address for the node
# name — the standard Phoenix release ip lookup, kept for the day this
# demo grows past one machine.
ip_v4_callback() {
    ip -4 -o address show scope global 2>/dev/null | while read -r _ _ addr _; do
      addr="${addr%/*}"
      echo "$addr"
      break
    done
}

ip_v6_callback() {
    ip -6 -o address show scope global 2>/dev/null | while read -r _ _ addr _; do
      addr="${addr%/*}"
      echo "$addr"
      break
    done
}

RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
RELEASE_NAME="${RELEASE_NAME:-<%= @release.name %>}@$(ip_v${RELEASE_IP:-4}_callback)"
