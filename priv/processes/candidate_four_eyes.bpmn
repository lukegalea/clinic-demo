<?xml version="1.0" encoding="UTF-8"?>

<!--
  The four-eyes approval of a roster candidate: the clinic manager AND the head
  vet must each sign it off before anything is written to the schedule.

  Two things to notice.

  1. The two sign-offs run in PARALLEL behind a fork and meet at a join. Neither
     task can complete the other's; one person holding both roles still has to
     be two different people, which the host enforces (it refuses the same
     clinician completing both).
  2. The graph never writes a Shift or an Assignment. When both tasks are done
     the host runs `Candidate.apply` as the second approver, in one
     transaction.
  3. Rejection is modelled in the graph: either sign-off completing `rejected`
     goes through an exclusive gateway to its own end event. The other branch is
     still live at that moment, so the instance is still running, and the host
     then cancels the instance (`AshBpmn.cancel_instance/2`): the engine kills the
     parked token and cancels the sibling task. A TERMINATE end event was tried
     and does not do this: it kills the other token but leaves its task row open.

  ASCII-only, like every process document here (see appointment_visit.bpmn).
-->

<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns" id="Definitions_candidate_four_eyes" targetNamespace="https://github.com/lukegalea/ash_bpmn/ns">
  <bpmn2:process id="Process_candidate_four_eyes" name="Roster candidate four-eyes approval" isExecutable="true">
    <bpmn2:startEvent id="Start_proposed" name="Candidate proposed">
      <bpmn2:outgoing>Flow_to_fork</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:parallelGateway id="Fork_signoffs" name="Both sign-offs">
      <bpmn2:incoming>Flow_to_fork</bpmn2:incoming>
      <bpmn2:outgoing>Flow_to_manager</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_to_head_vet</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:userTask id="ManagerSignoff" name="Clinic manager sign-off">
      <bpmn2:extensionElements>
        <ash:taskConfig>
          <ash:candidates>
            <ash:candidate kind="leadership" of="clinic_manager" />
          </ash:candidates>
          <ash:outcomes>
            <ash:outcome name="approved" />
            <ash:outcome name="rejected" />
          </ash:outcomes>
        </ash:taskConfig>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_to_manager</bpmn2:incoming>
      <bpmn2:outgoing>Flow_manager_decided</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="GateManager" name="Rejected?" default="Flow_manager_done">
      <bpmn2:incoming>Flow_manager_decided</bpmn2:incoming>
      <bpmn2:outgoing>Flow_manager_rejected</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_manager_done</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="HeadVetSignoff" name="Head vet sign-off">
      <bpmn2:extensionElements>
        <ash:taskConfig>
          <ash:candidates>
            <ash:candidate kind="leadership" of="head_vet" />
          </ash:candidates>
          <ash:outcomes>
            <ash:outcome name="approved" />
            <ash:outcome name="rejected" />
          </ash:outcomes>
        </ash:taskConfig>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_to_head_vet</bpmn2:incoming>
      <bpmn2:outgoing>Flow_head_vet_decided</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="GateHeadVet" name="Rejected?" default="Flow_head_vet_done">
      <bpmn2:incoming>Flow_head_vet_decided</bpmn2:incoming>
      <bpmn2:outgoing>Flow_head_vet_rejected</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_head_vet_done</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:parallelGateway id="Join_signoffs" name="Both done">
      <bpmn2:incoming>Flow_manager_done</bpmn2:incoming>
      <bpmn2:incoming>Flow_head_vet_done</bpmn2:incoming>
      <bpmn2:outgoing>Flow_to_end</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:endEvent id="End_rejected" name="Rejected">
      <bpmn2:extensionElements>
        <ash:taskConfig outcome="rejected" />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_manager_rejected</bpmn2:incoming>
      <bpmn2:incoming>Flow_head_vet_rejected</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="End_decided" name="Decided">
      <bpmn2:incoming>Flow_to_end</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="Flow_to_fork" sourceRef="Start_proposed" targetRef="Fork_signoffs" />
    <bpmn2:sequenceFlow id="Flow_to_manager" sourceRef="Fork_signoffs" targetRef="ManagerSignoff" />
    <bpmn2:sequenceFlow id="Flow_to_head_vet" sourceRef="Fork_signoffs" targetRef="HeadVetSignoff" />
    <bpmn2:sequenceFlow id="Flow_manager_decided" sourceRef="ManagerSignoff" targetRef="GateManager" />
    <bpmn2:sequenceFlow id="Flow_manager_rejected" name="rejected" sourceRef="GateManager" targetRef="End_rejected">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">task.outcome = "rejected"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_manager_done" sourceRef="GateManager" targetRef="Join_signoffs" />
    <bpmn2:sequenceFlow id="Flow_head_vet_decided" sourceRef="HeadVetSignoff" targetRef="GateHeadVet" />
    <bpmn2:sequenceFlow id="Flow_head_vet_rejected" name="rejected" sourceRef="GateHeadVet" targetRef="End_rejected">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">task.outcome = "rejected"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_head_vet_done" sourceRef="GateHeadVet" targetRef="Join_signoffs" />
    <bpmn2:sequenceFlow id="Flow_to_end" sourceRef="Join_signoffs" targetRef="End_decided" />
  </bpmn2:process>
</bpmn2:definitions>
