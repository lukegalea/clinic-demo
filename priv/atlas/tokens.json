{
  "$description": "Atlas design tokens (W3C Design Tokens format). Source: the Atlas Design System Figma library, file 3b7ijbITsWOm0Uygm08bok, Colour page read 2026-10-19. Hand-transcribed for the POC; `mix atlas.tokens.pull` replaces this file once Figma variable access is settled. Tokens whose value was not shown on the Colour page carry $extensions.atlas.source = \"inferred\" and must be re-checked against Figma.",
  "color": {
    "$type": "color",
    "neutral": {
      "0":   { "$value": "#FFFFFF" },
      "50":  { "$value": "#F9F9FA" },
      "100": { "$value": "#F4F5F5" },
      "200": { "$value": "#E0E2E4" },
      "300": { "$value": "#BEC2C5" },
      "400": { "$value": "#8B9198" },
      "500": { "$value": "#62686F" },
      "600": { "$value": "#3F444A" },
      "700": { "$value": "#18191B" }
    },
    "blue": {
      "50":  { "$value": "#EFF6FF", "$extensions": { "atlas": { "source": "inferred" } } },
      "100": { "$value": "#D2E5FF", "$extensions": { "atlas": { "source": "inferred" } } },
      "200": { "$value": "#4898FF", "$extensions": { "atlas": { "source": "inferred" } } },
      "300": { "$value": "#0B62DF" },
      "400": { "$value": "#0849A5" }
    },
    "red": {
      "50":  { "$value": "#FDF4F4", "$extensions": { "atlas": { "source": "inferred" } } },
      "100": { "$value": "#F8D5D5", "$extensions": { "atlas": { "source": "inferred" } } },
      "200": { "$value": "#EC7575" },
      "300": { "$value": "#CD2B2B" },
      "400": { "$value": "#A02121", "$extensions": { "atlas": { "source": "inferred" } } }
    },
    "green": {
      "50":  { "$value": "#F1F8F3", "$extensions": { "atlas": { "source": "inferred" } } },
      "100": { "$value": "#CCE5D3", "$extensions": { "atlas": { "source": "inferred" } } },
      "300": { "$value": "#108732" },
      "400": { "$value": "#0A511E", "$extensions": { "atlas": { "source": "inferred" } } }
    },
    "orange": {
      "50":  { "$value": "#FDF5ED", "$extensions": { "atlas": { "source": "inferred" } } },
      "100": { "$value": "#F9D9BB", "$extensions": { "atlas": { "source": "inferred" } } },
      "200": { "$value": "#F0A561" },
      "300": { "$value": "#DF7616" },
      "400": { "$value": "#954F0E" }
    },
    "gold": {
      "50":  { "$value": "#FBF9EC", "$extensions": { "atlas": { "source": "inferred" } } },
      "100": { "$value": "#F7EEBF", "$extensions": { "atlas": { "source": "inferred" } } },
      "200": { "$value": "#EED96D" },
      "400": { "$value": "#6D5E0D" }
    },
    "purple": {
      "50":  { "$value": "#F5F2FD", "$extensions": { "atlas": { "source": "inferred" } } },
      "400": { "$value": "#3D188B", "$extensions": { "atlas": { "source": "inferred" } } }
    }
  },
  "bg": {
    "$type": "color",
    "canvas":          { "$value": "{color.neutral.0}" },
    "surface":         { "$value": "{color.neutral.0}" },
    "surface-sunken":  { "$value": "{color.neutral.50}" },
    "neutral-subtle":  { "$value": "{color.neutral.50}" },
    "neutral":         { "$value": "{color.neutral.100}" },
    "neutral-hover":   { "$value": "{color.neutral.200}" },
    "neutral-active":  { "$value": "{color.neutral.300}" },
    "disabled":        { "$value": "{color.neutral.100}" },
    "brand":           { "$value": "{color.blue.300}" },
    "brand-hover":     { "$value": "{color.blue.400}", "$extensions": { "atlas": { "source": "inferred" } } },
    "brand-subtle":    { "$value": "{color.blue.50}",  "$extensions": { "atlas": { "source": "inferred" } } },
    "danger":          { "$value": "{color.red.300}" },
    "danger-hover":    { "$value": "{color.red.400}",  "$extensions": { "atlas": { "source": "inferred" } } },
    "danger-subtle":   { "$value": "{color.red.50}",   "$extensions": { "atlas": { "source": "inferred" } } },
    "success":         { "$value": "{color.green.300}" },
    "success-subtle":  { "$value": "{color.green.50}", "$extensions": { "atlas": { "source": "inferred" } } },
    "warning":         { "$value": "{color.orange.200}" },
    "warning-subtle":  { "$value": "{color.orange.50}", "$extensions": { "atlas": { "source": "inferred" } } },
    "pending":         { "$value": "{color.gold.200}" },
    "pending-subtle":  { "$value": "{color.gold.50}",  "$extensions": { "atlas": { "source": "inferred" } } },
    "info":            { "$value": "{color.blue.300}" },
    "info-subtle":     { "$value": "{color.blue.50}",  "$extensions": { "atlas": { "source": "inferred" } } },
    "inverse":         { "$value": "{color.neutral.700}" },
    "scrim":           { "$value": "rgb(24 25 27 / 0.7)", "$extensions": { "atlas": { "source": "inferred" } } }
  },
  "icon": {
    "$type": "color",
    "subtle": { "$value": "{color.neutral.500}", "$description": "Figma icon/subtle: the Modal and Drawer close icon" }
  },
  "text": {
    "$type": "color",
    "primary":         { "$value": "{color.neutral.700}" },
    "secondary":       { "$value": "{color.neutral.600}" },
    "tertiary":        { "$value": "{color.neutral.500}" },
    "placeholder":     { "$value": "{color.neutral.400}" },
    "disabled":        { "$value": "{color.neutral.300}" },
    "brand":           { "$value": "{color.blue.300}" },
    "brand-hover":     { "$value": "{color.blue.400}" },
    "danger":          { "$value": "{color.red.300}" },
    "success":         { "$value": "{color.green.300}" },
    "warning":         { "$value": "{color.orange.400}" },
    "pending":         { "$value": "{color.gold.400}" },
    "on-brand":        { "$value": "{color.neutral.0}" },
    "on-danger":       { "$value": "{color.neutral.0}" },
    "on-success":      { "$value": "{color.neutral.0}" },
    "on-warning":      { "$value": "{color.neutral.700}" },
    "on-pending":      { "$value": "{color.neutral.700}" },
    "on-info":         { "$value": "{color.neutral.0}" },
    "on-inverse":      { "$value": "{color.neutral.0}" }
  },
  "border": {
    "$type": "color",
    "default":         { "$value": "{color.neutral.200}" },
    "subtle":          { "$value": "{color.neutral.100}" },
    "strong":          { "$value": "{color.neutral.400}" },
    "disabled":        { "$value": "{color.neutral.200}" },
    "focus":           { "$value": "{color.neutral.700}" },
    "brand":           { "$value": "{color.blue.300}" },
    "danger":          { "$value": "{color.red.300}" },
    "success":         { "$value": "{color.green.300}" },
    "warning":         { "$value": "{color.orange.300}" },
    "pending":         { "$value": "{color.gold.400}" }
  },
  "spacing": {
    "$type": "dimension",
    "0":  { "$value": "0px" },  "2":  { "$value": "2px" },  "4":  { "$value": "4px" },
    "6":  { "$value": "6px" },  "8":  { "$value": "8px" },  "12": { "$value": "12px" },
    "16": { "$value": "16px" }, "20": { "$value": "20px" }, "24": { "$value": "24px" },
    "32": { "$value": "32px" }, "40": { "$value": "40px" }, "48": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "sm":      { "$value": "2px",  "$extensions": { "atlas": { "source": "inferred" } } },
    "default": { "$value": "4px" },
    "lg":      { "$value": "8px" },
    "xl":      { "$value": "10px" },
    "2xl":     { "$value": "12px" },
    "full":    { "$value": "9999px" }
  },
  "border-width": {
    "$type": "dimension",
    "1": { "$value": "1px" },
    "2": { "$value": "2px" }
  },
  "focus": {
    "$description": "One focus rule, decided 2026-09-21 on the Accessibility page: border/focus, 2px, 1px offset.",
    "width":  { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "1px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "-apple-system", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" }, "sm": { "$value": "14px" }, "md": { "$value": "16px" },
      "lg": { "$value": "18px" }, "xl": { "$value": "20px" }, "2xl": { "$value": "24px" }
    }
  },
  "elevation": {
    "$type": "shadow",
    "base": { "$value": "0px 1px 4px 0px rgb(0 0 0 / 0.04), 0px 1px 3px 0px rgb(0 0 0 / 0.05)" },
    "md":   { "$value": "0px 4px 12px 0px rgb(0 0 0 / 0.08)", "$extensions": { "atlas": { "source": "inferred" } } },
    "lg":   { "$value": "0px 10px 15px -3px rgb(0 0 0 / 0.1), 0px 4px 6px -4px rgb(0 0 0 / 0.1)", "$description": "Figma Elevation/lg (Modal)" },
    "2xl":  { "$value": "0px 25px 50px -12px rgb(0 0 0 / 0.25)", "$description": "Figma Elevation/2xl (Drawer)" }
  }
}
