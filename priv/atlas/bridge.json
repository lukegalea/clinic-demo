{
  "$description": "Which existing CSS custom property takes which Atlas token. `mix atlas.tokens.build` turns each entry into `--target: var(--atlas-<token>)`. A value that is not a token path (no `{}`) is written as a literal. Three groups: the A2UI basic catalog, ash_a2ui's admin catalog, and clinic-demo's current neobrutalism raw variables (so HEEx chrome follows Atlas until it is rebuilt from Atlas components).",

  "tailwind": {
    "$description": "Written inside Tailwind's @theme, not :root. Tailwind re-declares its theme variables on `:root, :host`, so a :root override is reset inside every shadow root that adopts the stylesheet; only the theme value itself survives there.",
    "--font-sans": "{font.family.sans}"
  },

  "a2ui": {
    "--a2ui-color-background":        "{bg.surface-sunken}",
    "--a2ui-color-on-background":     "{text.primary}",
    "--a2ui-color-surface":           "{bg.surface}",
    "--a2ui-color-on-surface":        "{text.primary}",
    "--a2ui-color-primary":           "{bg.brand}",
    "--a2ui-color-on-primary":        "{text.on-brand}",
    "--a2ui-color-secondary":         "{bg.surface}",
    "--a2ui-color-on-secondary":      "{text.primary}",
    "--a2ui-color-input":             "{bg.surface}",
    "--a2ui-color-on-input":          "{text.primary}",
    "--a2ui-color-border":            "{border.default}",
    "--a2ui-border-width":            "{border-width.1}",
    "--a2ui-border-radius":           "{radius.lg}",
    "--a2ui-button-border-radius":    "{radius.lg}",
    "--a2ui-textfield-border-radius": "{radius.lg}",
    "--a2ui-card-border-radius":      "{radius.xl}",
    "--a2ui-choicepicker-select-border-radius": "{radius.lg}",
    "--a2ui-chip-border-radius":      "{radius.full}",
    "--a2ui-swimlane-border-radius":  "{radius.xl}",
    "--a2ui-card-box-shadow":         "{elevation.base}",
    "--a2ui-button-box-shadow":       "none",
