{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "./bin/serena-mcp"
      ],
      "enabled": true,
      "environment": {
        "SERENA_CONTEXT": "agent"
      }
    },
    "ash_agent": {
      "type": "remote",
      "url": "http://127.0.0.1:4100",
      "enabled": true
    },
    "tidewave": {
      "type": "remote",
      "url": "http://127.0.0.1:4000/tidewave/mcp",
      "enabled": true
    }
  }
}
