<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="ClinicDemo" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The type system: DM Sans (body 500, headings 700) + Archivo Black
         for the loudest tier only — hero, section blocks, the brand. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <!-- The bpmn-js / dmn-js / canvas CSS, emitted by esbuild alongside app.js
         because the diagram hooks import their own stylesheets. -->
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
  </head>
  <body class="bg-background text-foreground font-base">
    <%!-- Neobrutalist nav, turned up: chunky pills that lift and tilt on
         hover (shadow grows, pill rises half a shadow, rotates 1°), press
         down on click. One loud yellow pill for "Acting as" — the control
         every demo starts from. --%>
    <% current_path = assigns[:current_path] || ""

    nav_pill =
      "inline-flex h-9 items-center justify-center gap-2 whitespace-nowrap rounded-full border-2 border-border bg-secondary-background px-4 text-sm font-base text-foreground shadow-shadow ring-offset-white transition-all focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:-rotate-1 hover:shadow-lift active:translate-x-0.5 active:translate-y-0.5 active:shadow-press"

    acting_as_pill =
      "inline-flex h-9 items-center justify-center gap-2 whitespace-nowrap rounded-full border-2 border-border bg-yellow px-4 text-sm font-base text-foreground shadow-shadow ring-offset-white transition-all focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:-rotate-1 hover:shadow-lift active:translate-x-0.5 active:translate-y-0.5 active:shadow-press" %>
    <div class="sticky top-0 z-40 flex min-h-fit flex-wrap items-center gap-x-2 gap-y-1 border-b-2 border-border bg-background px-4 py-2">
      <%!-- Live navigation: every pill's target is a LiveView inside
           live_session :a2ui (router.ex), so navigating keeps this nav
           mounted across surfaces instead of reloading the document per
           click. Classes are the design lane's, unchanged. --%>
      <.link
        class="flex items-center gap-2 px-2 text-lg font-display"
        navigate={~p"/"}
      >
        ClinicDemo
        <span
          class="inline-block size-3 -rotate-12 rounded-base border-2 border-border bg-yellow"
          aria-hidden="true"
        />
      </.link>
      <nav class="flex flex-wrap gap-1.5" aria-label="Main">
        <.link
          class={nav_pill}
          navigate={~p"/"}
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/")}
        >Board</.link>
        <.link
          class={nav_pill}
          navigate={~p"/intake"}
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/intake")}
        >Intake</.link>
        <.link
          class={nav_pill}
          navigate={~p"/schedule"}
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/schedule")}
        >Schedule</.link>
        <.link
          class={nav_pill}
          navigate={~p"/worklist"}
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/worklist")}
        >Worklist</.link>
        <.link
          class={nav_pill}
          navigate={~p"/visits"}
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/visits")}
        >Visits</.link>
        <.link
          class={nav_pill}
          navigate={~p"/patients"}
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/patients")}
        >Patients</.link>
        <.link
          class={nav_pill}
          navigate={~p"/clinicians"}
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/clinicians")}
        >Clinicians</.link>
        <.link
          class={nav_pill}
          navigate={~p"/processes"}
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/processes")}
        >Processes</.link>
        <.link
          class={nav_pill}
          navigate={~p"/decisions"}
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/decisions")}
        >Decisions</.link>
        <.link
          class={nav_pill}
          navigate={~p"/evaluations"}
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/evaluations")}
        >Evidence</.link>
        <%!-- /operator is a plain controller page, not a LiveView, so there
             is nothing to navigate to — this one stays a full load. --%>
        <a
          class={nav_pill}
          href="/operator"
          {AshA2ui.PresenceBar.nav_current_attrs(current_path, "/operator")}
        >Operator</a>
      </nav>
      <div class="ms-auto">
        <%!-- The picker shares the surfaces' live_session now, so this is
             live navigation. The actor SWITCH itself is still a full
             redirect by design — ActorPlug writes the session over HTTP
             and 302s back to where you came from. Classes are the design
             lane's, unchanged. --%>
        <.link
          class={acting_as_pill}
          navigate="/acting-as"
          aria-label={
            (assigns[:a2ui_actor_label] && "Acting as #{@a2ui_actor_label}") || "No one is acting"
          }
        >
          <%= if label = assigns[:a2ui_actor_label] do %>
            Acting as {label}
          <% else %>
            Acting as…
          <% end %>
        </.link>
      </div>
    </div>
    <main class="mx-auto max-w-[1300px] px-4 py-6">
      {@inner_content}
    </main>
  </body>
</html>
