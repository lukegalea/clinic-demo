<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="ClinicDemo" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <!-- The type system: DM Sans (body 500, headings 700) + Archivo Black
         for the loudest tier only — hero, section blocks, the brand.
         Self-hosted (priv/static/fonts, @font-face at the top of app.css):
         the baselines' text metrics must not depend on a third party's
         font CDN bumping a version. -->
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <!-- The bpmn-js / dmn-js / canvas CSS, emitted by esbuild alongside app.js
         because the diagram hooks import their own stylesheets. -->
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
  </head>
  <body class="bg-(--atlas-bg-canvas) text-foreground font-base">
    <%!-- Atlas POC shell, after the CLM Shell Wireframe: a slim app header
         (brand left; the acting user right) and the demo's navigation in a
         sidebar, so the header no longer wraps onto two rows. The nav is
         still NavPresenceLive (live region: pills + presence chips); only
         its layout moved. On narrow screens the sidebar becomes a
         horizontally scrolling strip under the header. --%>
    <header class="sticky top-0 z-40 h-14 flex items-center gap-3 border-b border-(--atlas-border-default) bg-(--atlas-bg-surface) px-4 font-sans">
      <.link
        class="text-xl tracking-tight text-(--atlas-text-primary)"
        navigate={~p"/"}
      >
        <span class="text-(--atlas-text-brand)">clinic</span>demo
      </.link>
      <div class="ms-auto flex items-center gap-3">
        <%!-- The picker shares the surfaces' live_session, so this is live
             navigation. The actor SWITCH itself is still a full redirect by
             design: ActorPlug writes the session over HTTP and 302s back. --%>
        <.link
          id="acting-as"
          class="inline-flex items-center gap-2 h-9 ps-1 pe-3 rounded-full text-sm text-(--atlas-text-primary) hover:bg-(--atlas-bg-surface-sunken) focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-(--atlas-border-focus)"
          navigate="/acting-as"
          aria-label={
            (assigns[:a2ui_actor_label] && "Acting as #{@a2ui_actor_label}") || "No one is acting"
          }
        >
          <% label = assigns[:a2ui_actor_label] %>
          <span
            aria-hidden="true"
            class={[
              "inline-flex size-7 items-center justify-center rounded-full text-xs font-semibold",
              label && "bg-(--atlas-bg-brand) text-(--atlas-text-on-brand)",
              !label && "border border-dashed border-(--atlas-border-strong)"
            ]}
          >
            {label && AshA2ui.PresenceBar.initials(label)}
          </span>
          <%= if label do %>
            Acting as {label}
          <% else %>
            Acting as…
          <% end %>
        </.link>
      </div>
    </header>
    <div class="md:flex">
      <aside class="md:w-56 md:shrink-0 md:sticky md:top-14 md:h-[calc(100vh-3.5rem)] overflow-auto border-b md:border-b-0 md:border-e border-(--atlas-border-default) bg-(--atlas-bg-surface) font-sans">
        {live_render(@conn, ClinicDemoWeb.A2ui.NavPresenceLive,
          id: "nav-presence",
          session: %{
            "actor_id" => assigns[:a2ui_actor_id],
            "current_path" => assigns[:current_path] || ""
          }
        )}
        <%!-- Atlas POC: the same Tag twice. The HEEx twin is server-rendered
             from priv/atlas/recipes.json; the Lit element styles itself once
             app.js defines it. They should be pixel-identical. Remove before
             any merge. --%>
        <div class="hidden md:flex flex-col items-start gap-1 px-4 py-3 border-t border-(--atlas-border-default)">
          <span class="text-xs text-(--atlas-text-tertiary)">Atlas POC</span>
          <Atlas.Components.tag color="gold" size="sm" id="atlas-tag-heex">
            HEEx twin
          </Atlas.Components.tag>
          <atlas-tag color="gold" size="sm" id="atlas-tag-lit">Lit element</atlas-tag>
        </div>
      </aside>
      <div class="flex-1 min-w-0">
        <%!-- Host flash area. The browser pipeline fetches flash, so conn
         assigns carry it here on document loads; the ActorPlug's
         stale-roster redirect lands its "no longer on the active roster"
         message this way, because the framework's own picker view renders
         no flash of its own. --%>
        <% flash = assigns[:flash] || %{} %>
        <% flash_error = flash["error"] || flash[:error] %>
        <div
          :if={flash_error}
          class="px-4 md:px-6 pt-4"
          role="alert"
          data-testid="host-flash"
        >
          <div class="relative w-full rounded-base border-2 border-border bg-black px-4 py-3 text-sm text-white shadow-shadow">
            <strong class="font-heading">{flash_error}</strong>
          </div>
        </div>
        <main class="px-4 md:px-6 py-6">
          {@inner_content}
        </main>
      </div>
    </div>
  </body>
</html>
